    <CheatEntry>
      <ID>120</ID>
      <Description>"Auto Assemble script"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : DSClient-Win64-Shipping.exe
  Version: 
  Date   : 2026-08-05
  Author : atult

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(piss,DSClient-Win64-Shipping.exe,28 7C 24 60 0F 10 00 0F 11 83 B8 00 00 00) // should be unique
alloc(newmem,$1000,piss)

label(code)
label(return)

newmem:

code:
  movups xmm0,[rax]
  movups [rbx+000000B8],xmm0
  jmp return

piss+04:
  jmp newmem
  nop 5
return:
registersymbol(piss)

[DISABLE]

piss+04:
  db 0F 10 00 0F 11 83 B8 00 00 00

unregistersymbol(piss)
dealloc(newmem)

