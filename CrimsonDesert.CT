        <CheatEntry>
          <ID>56</ID>
          <Description>"SCRIPTS"</Description>
          <Options moAllowManualCollapseAndExpand="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>54</ID>
              <Description>"Free Fly"</Description>
              <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
   Game   : CrimsonDesert.exe
   Author : atult

   State variable hack at the addps xmm0,[r13+00] injection point
   (CrimsonDesert.exe+3A409E7) — this instruction runs BEFORE the
   movups [r13+00],xmm0 store.

   state (registered symbol "state", 4 bytes, default 0):
     0 -&gt; no change
     1 -&gt; clamp xmm0's 2nd float to a minimum of -1.0
          direct maxss comparison: -1.0 vs the value itself
          e.g. value -20.0 -&gt; forced to -1.0 ; value 5.0 -&gt; stays 5.0
          state stays 1 (keeps clamping until you set it back to 0)
     2 -&gt; xmm0's 2nd float += 300.0, then state auto-resets to 0

   r13 is ONLY used in the final code: block (the original addps).
   case1/case2 never touch r13.

   state is declared with globalalloc BEFORE [ENABLE], so:
     - the symbol is auto-registered and usable even while the script is disabled
     - its address is stable across enable/disable (add "state" to the address
       list as a 4-byte value and it stays valid)
   The block below resets state to 0 every time you enable the script.
}

globalalloc(state,4) // registered symbol, stable address, survives disable

[ENABLE]

{$lua}
if syntaxcheck then return end
writeInteger("state",0)
{$asm}

aobscanmodule(kiss,CrimsonDesert.exe,41 0F 58 45 00 41) // should be unique
alloc(newmem,$1000,kiss)

label(code)
label(return)
label(float300)
label(minus1)
label(scratch)
label(case1)
label(case2)

newmem:
  cmp dword ptr [state],1
  je case1
  cmp dword ptr [state],2
  je case2
  jmp code

case1:
  // state == 1 : clamp xmm0 2nd float to &gt;= -1.0 — direct maxss,
  //              no r13 involved
  movups [scratch],xmm0
  movss xmm1,[minus1]        // xmm1 = -1.0
  maxss xmm1,[scratch+04]    // xmm1 = max(-1.0, value) ; -20 -&gt; -1.0
  movss [scratch+04],xmm1
  movups xmm0,[scratch]
  jmp code                   // original addps xmm0,[r13+00] runs here

case2:
  // state == 2 : xmm0 2nd float += 300.0, then state = 0
  movups [scratch],xmm0
  movss xmm1,[float300]
  addss xmm1,[scratch+04]
  movss [scratch+04],xmm1
  movups xmm0,[scratch]
  mov dword ptr [state],0
  jmp code

code:
  // original instruction — the ONLY place r13 is used
  addps xmm0,[r13+00]
  jmp return

float300:
  dd (float)300.0 // 300.0f

minus1:
  dd (float)0.0 // -1.0f

scratch:
  dd 0,0,0,0

kiss:
  jmp newmem
return:

registersymbol(kiss)

[DISABLE]

kiss:
  db 41 0F 58 45 00

unregistersymbol(kiss)
dealloc(newmem)

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>55</ID>
                  <Description>"state"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>4 Bytes</VariableType>
                  <Address>state</Address>
                  <Hotkeys>
                    <Hotkey>
                      <Action>Set Value</Action>
                      <Keys>
                        <Key>98</Key>
                      </Keys>
                      <Value>0</Value>
                      <ID>0</ID>
                    </Hotkey>
                    <Hotkey>
                      <Action>Set Value</Action>
                      <Keys>
                        <Key>101</Key>
                      </Keys>
                      <Value>1</Value>
                      <ID>1</ID>
                    </Hotkey>
                    <Hotkey>
                      <Action>Set Value</Action>
                      <Keys>
                        <Key>104</Key>
                      </Keys>
                      <Value>2</Value>
                      <ID>2</ID>
                    </Hotkey>
                  </Hotkeys>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>57</ID>
              <Description>"Free Fly 2"</Description>
              <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
   Game   : CrimsonDesert.exe
   Author : atult

   State variable hack at the addps xmm0,[r13+00] injection point
   (CrimsonDesert.exe+3A409E7) — this instruction runs BEFORE the
   movups [r13+00],xmm0 store.

   xmm0 layout:  [1st float][2nd float][3rd float][4th float]
                  byte 00    byte 04    byte 08    byte 0C

   FOR ALL STATES (0, 1, 2):
     1st float (byte 00) and 3rd float (byte 08) are multiplied by
     [multiplier] BEFORE the addps.

     multiplier is a globalalloc'd symbol (float, default 2.0).
     To change it: edit the writeFloat line in [ENABLE] below, OR add
     "multiplier" to the address list as a 4-byte Float and edit live.
     (Note: re-enabling the script reloads the value from the script line.)

   state (registered symbol "state", 4 bytes, default 0):
     0 -&gt; no change to the 2nd float
     1 -&gt; clamp xmm0's 2nd float to a minimum of -1.0
          direct maxss: -1.0 vs the value itself
          e.g. value -20.0 -&gt; forced to -1.0 ; value 5.0 -&gt; stays 5.0
          state stays 1 (keeps clamping until you set it back to 0)
     2 -&gt; xmm0's 2nd float += 300.0, then state auto-resets to 0

   r13 is ONLY used in the final code: block (the original addps).
   The multiplier and state blocks never touch r13.

   state is declared with globalalloc BEFORE [ENABLE], so:
     - the symbols are auto-registered and usable even while the script is disabled
     - their addresses are stable across enable/disable
   The  block resets state to 0 and multiplier to 2.0 on every enable.
}

globalalloc(state,4)      // registered symbol, stable address
globalalloc(multiplier,4) // registered symbol, stable address

[ENABLE]

{$lua}
if syntaxcheck then return end
writeInteger("state",0)
writeFloat("multiplier",5.0) -- &lt;&lt;&lt; DEFAULT MULTIPLIER - edit this value if you want
{$asm}

aobscanmodule(kiss,CrimsonDesert.exe,41 0F 58 45 00 41) // should be unique
alloc(newmem,$1000,kiss)

label(code)
label(return)
label(float300)
label(minus1)
label(scratch)
label(case1)
label(case2)

newmem:
  // ---- FOR ALL CASES: multiply 1st and 3rd float by [multiplier] ----
  movups [scratch],xmm0
  movss xmm1,[multiplier]
  movss xmm2,[scratch+00]   // 1st float
  mulss xmm2,xmm1
  movss [scratch+00],xmm2
  movss xmm2,[scratch+08]   // 3rd float
  mulss xmm2,xmm1
  movss [scratch+08],xmm2
  movups xmm0,[scratch]
  // ---- state dispatch ----
  cmp dword ptr [state],1
  je case1
  cmp dword ptr [state],2
  je case2
  jmp code

case1:
  // state == 1 : clamp 2nd float to &gt;= -1.0 — direct maxss, no r13
  movups [scratch],xmm0
  movss xmm1,[minus1]        // xmm1 = -1.0
  maxss xmm1,[scratch+04]    // xmm1 = max(-1.0, value) ; -20 -&gt; -1.0
  movss [scratch+04],xmm1
  movups xmm0,[scratch]
  jmp code                   // original addps xmm0,[r13+00] runs here

case2:
  // state == 2 : 2nd float += 300.0, then state = 0
  movups [scratch],xmm0
  movss xmm1,[float300]
  addss xmm1,[scratch+04]
  movss [scratch+04],xmm1
  movups xmm0,[scratch]
  mov dword ptr [state],0
  jmp code

code:
  // original instruction — the ONLY place r13 is used
  addps xmm0,[r13+00]
  jmp return

float300:
  dd 43960000 // 300.0f

minus1:
  dd (float)0.0 // -1.0f

scratch:
  dd 0,0,0,0

kiss:
  jmp newmem
return:

registersymbol(kiss)

[DISABLE]

kiss:
  db 41 0F 58 45 00

unregistersymbol(kiss)
dealloc(newmem)


</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>58</ID>
                  <Description>"state"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>4 Bytes</VariableType>
                  <Address>state</Address>
                </CheatEntry>
                <CheatEntry>
                  <ID>59</ID>
                  <Description>"multiplier"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>Float</VariableType>
                  <Address>multiplier</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
      </CheatEntries>
